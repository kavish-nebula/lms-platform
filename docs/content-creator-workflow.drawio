        <mxCell id="subtitle" value="Current Codex-assisted authoring flow — editable course package, human review, publishing deferred" style="text;html=1;align=left;verticalAlign=middle;resizable=0;autosize=1;points=[];fontSize=13;fontColor=#5C667A;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="980" height="24" as="geometry" /></mxCell>

