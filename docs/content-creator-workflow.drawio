        <mxCell id="lane3" value="3  ·  EDIT, SYNTHESIZE, REVIEW — PUBLISHING IS OUT OF SCOPE" style="swimlane;html=1;startSize=32;horizontal=1;rounded=1;arcSize=12;fillColor=#FBF7F1;swimlaneFillColor=#FBF7F1;strokeColor=#E9D9C5;fontColor=#634A2F;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="626" width="1740" height="210" as="geometry" /></mxCell>
