        <mxCell id="gate0" value="&lt;b&gt;Save brief&lt;/b&gt;&lt;br&gt;Completeness checks flag missing inputs;&lt;br&gt;they do not approve the brief" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#73829A;strokeWidth=1.5;fontColor=#172033;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="360" y="164" width="245" height="100" as="geometry" /></mxCell>
        <mxCell id="blueprint" value="&lt;b&gt;Stage 2 · AI blueprint&lt;/b&gt;&lt;br&gt;Optional analysis of objectives,&lt;br&gt;sequence, tasks and assessments" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#73829A;strokeWidth=1.5;fontColor=#172033;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="700" y="164" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="stage3" value="&lt;b&gt;Stage 3 · Module SME QC&lt;/b&gt;&lt;br&gt;Separate module review path;&lt;br&gt;Codex full-course authoring is not gated by it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#73829A;strokeWidth=1.5;fontColor=#172033;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="1060" y="164" width="265" height="100" as="geometry" /></mxCell>
        <mxCell id="optionalNote" value="Optional blueprint and its current output can be included as context for Codex. SME text is reference data, never instructions." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E9EEF8;strokeColor=none;fontColor=#35415A;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="1400" y="164" width="325" height="100" as="geometry" /></mxCell>
