ant question" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#41566b;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="335" y="435" width="190" height="45" as="geometry"/></mxCell><mxCell id="p2-p3" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#52677d;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="context-m1" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#52677d;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4838709677419355;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="575" y="815"/><mxPoint x="575" y="345"/></Array></mxGeometry></mxCell><mxCell id="m1-m2" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#52677d;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="m2-m3" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#52677d;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="performance" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#52677d;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4838709677419355;entryDx=0;entryDy=0;" edge="1" parent="1" source="m3" target="e1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="815"/><mxPoint x="1120" y="345"/></Array></mxGeometry></mxCell><mxCell id="e1-e2" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#52677d;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2-e3" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#52677d;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="rule-title" value="What drives adaptation?" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#183047;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="965" width="1520" height="45" as="geometry"/></mxCell><mxCell id="rules" value="Module 1: profile + enrollment context; help requests and wrong answers can trigger a new explanation.&#xa;Module 2: the same context plus verified Module 1 evidence and authored prerequisite definitions.&#xa;Playback time and replays are recorded as context; they are not proof of mastery." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#334a60;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="1015" width="1520" height="90" as="geometry"/></mxCell><mxCell id="flow-footer" value="Learning objectives, assessment standards and the final assessment remain authored. | Existing implementation • 21 October 2026" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#52677d;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="1140" width="1520" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>