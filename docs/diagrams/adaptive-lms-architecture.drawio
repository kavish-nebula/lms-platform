 + audio at safe boundaries&#xa;Help requests can trigger a rewrite." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#334a60;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="m3"><mxGeometry x="26" y="69" width="388" height="91" as="geometry"/></mxCell><mxCell id="e1" value="" style="rounded=1;arcSize=12;container=1;collapsible=0;whiteSpace=wrap;html=0;fillColor=#f0fdfa;strokeColor=#0d9488;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1170" y="270" width="440" height="155" as="geometry"/></mxCell><mxCell id="e1-title" value="Verify Module 1 answers" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=29;fontColor=#142d45;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="e1"><mxGeometry x="26" y="18" width="388" height="42" as="geometry"/></mxCell><mxCell id="e1-body" value="Next.js grades checks, scenarios&#xa;and module quiz responses." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=23;fontColor=#334a60;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="e1"><mxGeometry x="26" y="69" width="388" height="76" as="geometry"/></mxCell><mxCell id="e2" value="" style="rounded=1;arcSize=12;container=1;collapsible=0;whiteSpace=wrap;html=0;fillColor=#f0fdfa;strokeColor=#0d9488;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1170" y="500" width="440" height="155" as="geometry"/></mxCell><mxCell id="e2-title" value="Summarise and queue" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=29;fontColor=#142d45;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="e2"><mxGeometry x="26" y="18" width="388" height="42" as="geometry"/></mxCell><mxCell id="e2-body" value="Verified attempts, correct answers&#xa;and misses update support." style="text;html=0;whiteSpace=wrap;align=left;verticalAlig