digraph LMS {
graph [rankdir=TB, bgcolor="#ffffff", pad="0.5", nodesep="0.25", ranksep="0.75", splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=22, labelloc=t, label="NEBULA KNOWLAB | PostgreSQL entity relationship diagram\n36 application tables · 61 enforced foreign keys · 12 November 2026\nPK = primary key   FK = foreign key   UK = unique key   ? = nullable\nParent → child: | = one   o = zero/optional   crow’s foot = many\nKey columns + selected attributes shown. JSON/text references and code-defined courses are not extra SQL relationships."];
node [shape=plain,fontname="Arial",fontsize=11];
edge [color="#94a3b8",penwidth=1.1,arrowsize=0.7];
