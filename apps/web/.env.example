# Copy to .env.local (gitignored) and fill in what you need.
# Never put real keys in this file: it is committed.
PROFESSIONAL_DEMO_ENABLED=false
LLM_API_KEY=
# Gemini API-key configuration (OpenAI-compatible endpoint).
# LLM_PROVIDER=openai selects the protocol; the URL selects Google Gemini.
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.5-flash
# Never paste a service-account private key into LLM_API_KEY or AUDIO_API_KEY.
# MCP bearer_token_env_var belongs in the MCP client config and names an
# environment variable (for example LMS_ILDCREATOR_TOKEN), not the token itself.

# Google Cloud Vertex AI. Imported SCORM learner pilots use Vertex for both
# text and narration; other courses keep LLM_PROVIDER / AUDIO_PROVIDER above.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=C:/credentials/service-account.json
# ADC also works without GOOGLE_APPLICATION_CREDENTIALS when configured locally
# or through the machine's attached service account. Tokens refresh automatically.
# LLM_PROVIDER=vertex
# AUDIO_PROVIDER=vertex
# AUDIO_LOCATION=us-central1
# Set AUDIO_LOCATION only to a region supported by your selected speech model.
# Vertex failures never fall back to the Gemini API-key endpoint for SCORM pilots.

GLM_API_KEY=

PLATFORM_ENGAGEMENT_ENABLED=false

#
ADAPTIVE_PYTHON_ENABLED=true

ADAPTIVE_BACKGROUND_ENABLED=true
# Set false only for request-only debugging; automatic module adaptation needs this worker lane.

# Adaptive lessons: narration for rewritten lessons. With an audio key, Gemini text-to-speech speaks it
# (a few clips at a time); Kokoro is the fallback when the API is busy or out of quota.
# AUDIO_PROVIDER=gemini
# AUDIO_API_KEY=
# AUDIO_MODEL=gemini-3.8-flash-lite-tts
# AUDIO_VOICE=Charon
# AUDIO_STYLE=A warm, clear course narrator explaining a lesson to an adult learner, at a steady, unhurried pace.
# AUDIO=off
#
# Kokoro (kokoro-js), on this machine:
# The model (~330 MB at fp32) downloads on first use. KOKORO=off plays rewritten lessons with captions only.
# KOKORO_DEVICE: cpu (default), dml (DirectML GPU on Windows), cuda (NVIDIA on Linux); a GPU that fails falls back to cpu.
# KOKORO_DTYPE: fp32 (default; fastest on CPU), fp16, q8
# KOKORO=off
# KOKORO_VOICE=am_michael
# KOKORO_DEVICE=cpu
# KOKORO_DTYPE=fp32
# Every enrolled course gets profile-based concept slides and narration.
# Set ADAPTIVE_PYTHON_ENABLED=false for a web-only/offline preview.

# Optional concept-video transcription. Defaults to Vertex when GOOGLE_CLOUD_PROJECT is set.
# TRANSCRIPTION_PROVIDER=vertex
# TRANSCRIPTION_MODEL=gemini-3.5-flash
# LMS_VIDEO_DIR=C:/lms-platform/apps/web/.data/concept-videos
